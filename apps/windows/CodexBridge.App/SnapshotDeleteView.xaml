<UserControl x:Class="CodexBridge.App.SnapshotDeleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding}"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource UiDeleteSnapshot}"
                    Click="DeleteClick"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="76"
                    Padding="12,5"/>
            <Button Content="{DynamicResource UiCancel}"
                    Click="CancelClick"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="76"
                    Margin="8,0,0,0"
                    Padding="12,5"/>
        </StackPanel>
    </Grid>
</UserControl>
