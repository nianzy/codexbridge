<UserControl x:Class="CodexBridge.App.WorkspaceSwitchConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{DynamicResource Background}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{DynamicResource UiSwitchWorkspace}" Click="ConfirmClick"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" Padding="12,5"/>
            <Button Content="{DynamicResource UiCancel}" Click="CancelClick" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" Margin="8,0,0,0" Padding="12,5"/>
        </StackPanel>
    </Grid>
</UserControl>
