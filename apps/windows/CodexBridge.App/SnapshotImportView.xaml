<UserControl x:Class="CodexBridge.App.SnapshotImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource UiSnapshotImportConfirm}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                <DockPanel Margin="0,0,0,8"><TextBlock Text="{DynamicResource UiSnapshotNameDisplay}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="{Binding SnapshotName}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
                <DockPanel><TextBlock Text="{DynamicResource UiSnapshotId}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding SnapshotId}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/></DockPanel>
                <DockPanel><TextBlock Text="{DynamicResource UiSchema}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding SchemaVersion}" Foreground="{DynamicResource TextSecondary}"/></DockPanel>
                <DockPanel Margin="0,8,0,0"><TextBlock Text="{DynamicResource UiSnapshotOriginalWorkspace}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding OriginalWorkspaceName}" Foreground="{DynamicResource TextSecondary}"/></DockPanel>
                <DockPanel><TextBlock Text="{DynamicResource UiPath}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding OriginalWorkspacePath}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/></DockPanel>
                <DockPanel Margin="0,8,0,0"><TextBlock Text="{DynamicResource UiSnapshotCurrentWorkspace}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding CurrentWorkspaceName}" Foreground="{DynamicResource TextSecondary}"/></DockPanel>
                <DockPanel><TextBlock Text="{DynamicResource UiSnapshotCurrentWorkspacePath}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding CurrentWorkspacePath}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/></DockPanel>
                <DockPanel><TextBlock Text="{DynamicResource UiSelectedTurnsDisplay}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding SelectionCount}" Foreground="{DynamicResource TextSecondary}"/></DockPanel>
                <DockPanel><TextBlock Text="{DynamicResource UiContextItemsDisplay}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding ContextCount}" Foreground="{DynamicResource TextSecondary}"/></DockPanel>
                <DockPanel><TextBlock Text="{DynamicResource UiHandoffDisplay}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding HandoffTitle}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/></DockPanel>
                <DockPanel Margin="0,8,0,0"><TextBlock Text="{DynamicResource UiSavedAt}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding CreatedAt}" Foreground="{DynamicResource TextSecondary}"/></DockPanel>
                <DockPanel><TextBlock Text="{DynamicResource UiUpdatedAt}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding UpdatedAt}" Foreground="{DynamicResource TextSecondary}"/></DockPanel>
                <TextBlock Text="{Binding WorkspaceMismatchWarning}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource UiImportSnapshot}" Click="ImportClick" Style="{StaticResource PrimaryButtonStyle}" MinWidth="84" Padding="12,5"/>
            <Button Content="{DynamicResource UiCancel}" Click="CancelClick" Style="{StaticResource SecondaryButtonStyle}" MinWidth="84" Margin="8,0,0,0" Padding="12,5"/>
        </StackPanel>
    </Grid>
</UserControl>
