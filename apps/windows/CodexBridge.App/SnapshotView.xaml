<UserControl x:Class="CodexBridge.App.SnapshotView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource UiSnapshotNameLabel}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding SnapshotName, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="7" ToolTip="{DynamicResource UiSnapshotName}"/></StackPanel><Button DockPanel.Dock="Right" Content="{DynamicResource UiSaveSnapshot}" Click="SaveClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="12,5"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,12"><ListBox ItemsSource="{Binding SnapshotEntries}" SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}" BorderThickness="0" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource TextPrimary}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding DisplayName}" FontFamily="Segoe UI Semibold"/><TextBlock Text="{Binding Snapshot.UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding Snapshot.Workspace.Name, StringFormat=工作区：{0}}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding Snapshot.ContextItems.Count, StringFormat=上下文：{0} 项}" Foreground="{DynamicResource TextSecondary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{DynamicResource UiNoSnapshots}" Foreground="{DynamicResource TextSecondary}" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="点击“保存当前现场”创建第一个工作现场。" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapshotEntries.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SnapshotEntries.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style></StackPanel></Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource UiSnapshotPreview}" Click="PreviewClick" IsEnabled="{Binding CanPreviewSnapshot}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"/><Button Content="{DynamicResource UiRestoreSnapshot}" Click="RestoreClick" IsEnabled="{Binding CanRestoreSnapshot}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="12,5"/><Button Content="{DynamicResource UiRenameSnapshot}" Click="RenameClick" IsEnabled="{Binding CanRenameSnapshot}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="12,5"/><Button Content="{DynamicResource UiDeleteSnapshot}" Click="DeleteClick" IsEnabled="{Binding CanDeleteSnapshot}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="12,5"/></StackPanel>
    </Grid>
</UserControl>
