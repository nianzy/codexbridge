<UserControl x:Class="CodexBridge.App.Controls.ContextPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12" Background="{DynamicResource PanelBackground}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="{DynamicResource UiContext}" FontFamily="Segoe UI Semibold" FontSize="16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right"><Button Content="{DynamicResource UiPreview}" Command="{Binding PreviewContextCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0"/><Button Content="{DynamicResource UiCopyContext}" Command="{Binding CopyContextCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0"/><Button Content="{DynamicResource UiExportContext}" Command="{Binding ExportContextCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4"/></StackPanel></DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8"><TextBlock Text="{Binding ContextItemSummary}"/><TextBlock Text="{Binding ContextCharacterSummary}" Margin="12,0,0,0"/><TextBlock Text="{Binding ContextSizeState}" Margin="12,0,0,0"/></StackPanel>
        <Grid Grid.Row="2"><ListBox ItemsSource="{Binding ContextItems}" BorderThickness="0" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource TextPrimary}"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2"><Button Content="×" Tag="{Binding}" Click="RemoveClick" DockPanel.Dock="Right" Padding="4,0"/><StackPanel><TextBlock Text="{Binding Type}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Foreground="{DynamicResource TextPrimary}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="暂无上下文&#x0a;请选择会话轮次、文件、差异或笔记以构建上下文包。" TextWrapping="Wrap" MaxWidth="280" Margin="20" TextAlignment="Center" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ContextItemCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource UiClear}" Command="{Binding ClearContextCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"/></StackPanel>
    </Grid></Border>
</UserControl>
