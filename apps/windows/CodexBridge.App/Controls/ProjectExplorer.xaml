<UserControl x:Class="CodexBridge.App.Controls.ProjectExplorer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CodexBridge.App.Controls">
    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0" Padding="8">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,8">
                <TextBlock Text="Project Explorer" FontFamily="Segoe UI Semibold" FontSize="15" VerticalAlignment="Center" />
                <Button Content="↻" Click="RefreshClick" ToolTip="Refresh" Margin="8,0,0,0" Padding="6,2" />
                <Button Content="Context" Click="ContextClick" Margin="4,0,0,0" Padding="6,2" />
                <Button Content="Notes" Click="NotesClick" Margin="4,0,0,0" Padding="6,2" />
            </StackPanel>
            <TreeView x:Name="Tree" ItemsSource="{Binding ProjectRootItems}" SelectedItemChanged="TreeSelected">
                <TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type controls:ProjectTreeItem}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}"><TextBlock.ContextMenu><ContextMenu><MenuItem Header="Add to Context" Click="AddContextClick"/></ContextMenu></TextBlock.ContextMenu></TextBlock></HierarchicalDataTemplate></TreeView.Resources>
            </TreeView>
        </DockPanel>
    </Border>
</UserControl>
