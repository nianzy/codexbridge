<UserControl x:Class="CodexBridge.App.Controls.DiffView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12" Background="{StaticResource PanelBackground}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding DiffPreviewTitle, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,0,0,8"/><TextBox Grid.Row="1" Text="{Binding DiffPreviewText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></Border>
</UserControl>
