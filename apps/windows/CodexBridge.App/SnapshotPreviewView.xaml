<UserControl x:Class="CodexBridge.App.SnapshotPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource UiSnapshotInformation}" Style="{StaticResource PageHeadingStyle}"/>
                <Grid Margin="0,8,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource UiSnapshotNameDisplay}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource UiSavedAt}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedAt}"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource UiUpdatedAt}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedAt}"/>
                    <TextBlock Grid.Row="3" Text="{DynamicResource UiWorkspaceDisplay}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WorkspaceName}"/>
                    <TextBlock Grid.Row="4" Text="{DynamicResource UiPath}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WorkspacePath}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="5" Text="{DynamicResource UiSnapshotId}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SnapshotId}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource UiSchema}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Column="3" Text="{Binding SchemaVersion}"/>
                    <TextBlock Grid.Row="6" Text="{DynamicResource UiSnapshotType}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SnapshotType}"/>
                </Grid>
                <TextBlock Text="{DynamicResource UiSnapshotOverview}" Style="{StaticResource PageHeadingStyle}"/>
                <TextBlock Margin="0,8,0,14" TextWrapping="Wrap"><Run Text="{DynamicResource UiSelectedTurnsDisplay}"/><Run Text="{Binding SelectionCount}"/><Run Text="&#x0a;"/><Run Text="{DynamicResource UiContextItemsDisplay}"/><Run Text="{Binding ContextCount}"/><Run Text="&#x0a;"/><Run Text="{DynamicResource UiHandoffDisplay}"/><Run Text="{Binding HandoffTitle}"/><Run Text="&#x0a;"/><Run Text="{DynamicResource UiGitBranchDisplay}"/><Run Text="{Binding GitBranch}"/></TextBlock>
                <TextBlock Text="{DynamicResource UiSnapshotComparison}" Style="{StaticResource PageHeadingStyle}"/>
                <Grid Margin="0,8,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource UiItem}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource UiSnapshotColumn}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" Margin="8,0"/><TextBlock Grid.Column="2" Text="{DynamicResource UiCurrentColumn}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" Margin="8,0"/><TextBlock Grid.Column="3" Text="{DynamicResource UiStatus}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/></Grid>
                <ItemsControl ItemsSource="{Binding Comparisons}" Margin="0,0,0,14"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding SnapshotValue}" TextTrimming="CharacterEllipsis" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding CurrentValue}" TextTrimming="CharacterEllipsis" Margin="8,0"/><TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{Binding WorkspaceAffinityMessage}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource UiSnapshotTurns}" Style="{StaticResource PageHeadingStyle}"/>
                <Grid Margin="0,8,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource UiSelectionSourceHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource UiSelectionSessionHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{DynamicResource UiSelectionRoleHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{DynamicResource UiSelectionTurnIdHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="{DynamicResource UiSelectionStatusHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/></Grid>
                <ItemsControl ItemsSource="{Binding Turns}" Margin="0,0,0,14"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="180"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}"/><TextBlock Grid.Column="1" Text="{Binding SessionId}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Role}"/><TextBlock Grid.Column="3" Text="{Binding TurnId}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{DynamicResource UiSnapshotContext}" Style="{StaticResource PageHeadingStyle}"/>
                <Grid Margin="0,8,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource UiContextTypeHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource UiContextTitleHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{DynamicResource UiContextReferenceHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{DynamicResource UiContextCharacterHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/></Grid>
                <ItemsControl ItemsSource="{Binding ContextItems}" Margin="0,0,0,14"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Type}"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding ReferencePath}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3"><Run Text="{Binding CharacterCount}"/><Run Text=" 字符"/></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{DynamicResource UiSnapshotHandoff}" Style="{StaticResource PageHeadingStyle}"/>
                <Grid Margin="0,8,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{DynamicResource UiTarget}"/><TextBlock Grid.Column="1" Text="{Binding Handoff.Target}"/><TextBlock Grid.Row="1" Text="{DynamicResource UiTemplate}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Handoff.Template}"/><TextBlock Grid.Row="2" Text="{DynamicResource UiTitle}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Handoff.Title}" TextWrapping="Wrap"/><TextBlock Grid.Row="3" Text="{DynamicResource UiTask}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Handoff.Task}" TextWrapping="Wrap"/><TextBlock Grid.Row="4" Text="{DynamicResource UiCurrentState}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Handoff.CurrentState}" TextWrapping="Wrap"/><TextBlock Grid.Row="5" Text="{DynamicResource UiConstraints}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Handoff.Constraints}" TextWrapping="Wrap"/><TextBlock Grid.Row="6" Text="{DynamicResource UiNextAction}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Handoff.NextAction}" TextWrapping="Wrap"/><TextBlock Grid.Row="7" Text="{DynamicResource UiIncludeContext}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Handoff.IncludeContextPack}"/><TextBlock Grid.Row="8" Text="{DynamicResource UiIncludeWorkspace}"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Handoff.IncludeWorkspace}"/><TextBlock Grid.Row="7" Grid.Column="2" Text="{DynamicResource UiIncludeGit}"/><TextBlock Grid.Row="7" Grid.Column="3" Text="{Binding Handoff.IncludeGitState}"/><TextBlock Grid.Row="8" Grid.Column="2" Text="{DynamicResource UiIncludeProjectFiles}"/><TextBlock Grid.Row="8" Grid.Column="3" Text="{Binding Handoff.IncludeProjectFileSummary}"/></Grid>
                <TextBlock Text="{DynamicResource UiSnapshotGit}" Style="{StaticResource PageHeadingStyle}"/>
                <Grid Margin="0,8,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource UiGitItemHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{DynamicResource UiGitSnapshotHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{DynamicResource UiGitCurrentHeader}" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/></Grid>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{DynamicResource UiBranch}"/><TextBlock Grid.Column="1" Text="{Binding Git.SnapshotBranch}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Git.CurrentBranch}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{DynamicResource UiGitHeadLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Git.SnapshotHead}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Git.CurrentHead}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" Text="{DynamicResource UiChangedFiles}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Git.SnapshotChangedFileCount}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Git.CurrentChangedFileCount}"/><TextBlock Grid.Row="3" Text="{DynamicResource UiFingerprint}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Git.SnapshotFingerprint}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Git.CurrentFingerprint}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="4" Text="{DynamicResource UiResult}"/><TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Git.Result}"/><ItemsControl Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Git.Reasons}"/></Grid>
                <TextBlock Text="{DynamicResource UiSnapshotAfterRestore}" Style="{StaticResource PageHeadingStyle}"/>
                <TextBlock Margin="0,8,0,0" Text="{DynamicResource UiSnapshotWillRestore}" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="{DynamicResource UiWillRestoreSelection}"/><TextBlock Text="{DynamicResource UiWillRestoreContext}"/><TextBlock Text="{DynamicResource UiWillRestoreHandoff}"/>
                <TextBlock Margin="0,8,0,0" Text="{DynamicResource UiSnapshotWillNotModify}" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="{DynamicResource UiWillNotModifyWorkspaceFiles}"/><TextBlock Text="{DynamicResource UiWillNotModifyGitBranch}"/><TextBlock Text="{DynamicResource UiWillNotModifyGitHead}"/><TextBlock Text="{DynamicResource UiWillNotModifyGitTree}"/><TextBlock Text="{DynamicResource UiWillNotModifyCodex}"/><TextBlock Text="{DynamicResource UiWillNotModifyChatGpt}"/><TextBlock Text="{DynamicResource UiWillNotModifyClipboard}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="{DynamicResource UiClose}" Click="CloseClick" Style="{StaticResource SecondaryButtonStyle}" Padding="14,5"/><Button Content="{DynamicResource UiRestoreThisSnapshot}" Click="RestoreClick" IsEnabled="{Binding CanRestore}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="14,5"/></StackPanel>
    </Grid>
</UserControl>
