{
  "manifest_version": 3,
  "name": "Codex Bridge for ChatGPT",
  "version": "1.1.1",
  "key": "",
  "description": "将 ChatGPT 网页中选中的对话轮次保存到 Codex Bridge。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "nativeMessaging", "sidePanel", "storage", "webNavigation"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-capture.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "在 Codex Bridge 中整理",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": { "default_path": "side-panel.html" }
}
